<Project>

  <!-- Package metadata shared by the four libraries. Demos and test harnesses are not packed. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Antd.Wpf contributors</Authors>
    <Company>Antd.Wpf</Company>
    <Product>Ant Design for WPF</Product>
    <Copyright>Copyright (c) Antd.Wpf contributors</Copyright>
    <PackageTags>wpf;antd;ant-design;design-system;ui;net48;dotnet</PackageTags>
    <PackageProjectUrl>https://gitee.com/davva/antd.-wpf.-tokens</PackageProjectUrl>
    <RepositoryUrl>https://gitee.com/davva/antd.-wpf.-tokens.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
