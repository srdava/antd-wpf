<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:antd="clr-namespace:Antd.Wpf.Controls"
    xmlns:icons="clr-namespace:Antd.Wpf.Icons;assembly=Antd.Wpf.Icons"
    xmlns:theme="clr-namespace:Antd.Wpf.Theme.Markup;assembly=Antd.Wpf.Theme">

    <theme:RatioConverter x:Key="Antd.HalfRatio" Ratio="0.5" />
    <theme:RatioConverter x:Key="Antd.NegHalfRatio" Ratio="-0.5" />

    <!-- antd layers three box-shadows; WPF has one blur, so this is tuned to look like the
         same elevation without a shadow gutter. Popups that size to their content still clip
         it - see docs/visual-parity.md. -->
    <DropShadowEffect x:Key="Antd.Effect.Elevated"
                      BlurRadius="18"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.16"
                      Color="#000000"
                      RenderingBias="Quality" />

    <DropShadowEffect x:Key="Antd.Effect.Popup"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270"
                      Opacity="0.16"
                      Color="#000000"
                      RenderingBias="Quality" />

    <!-- Shared keyboard focus ring: an adorner, so any control can use it without editing its
         template. Input and Button draw their own ring inside the template and keep it off. -->
    <Style x:Key="Antd.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="6"
                               RadiusY="6"
                               Stroke="{DynamicResource Antd.controlOutline}"
                               StrokeThickness="2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Button -->

    <Style TargetType="{x:Type antd:Button}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="OutlineThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Button}">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Border x:Name="SolidOutline"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Rectangle x:Name="DashedOutline"
                                   RadiusX="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                                   RadiusY="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                                   Stroke="{TemplateBinding BorderBrush}"
                                   StrokeThickness="{TemplateBinding OutlineThickness}"
                                   StrokeDashArray="3 3"
                                   SnapsToDevicePixels="True" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="IconHost"
                                              Content="{TemplateBinding Icon}"
                                              Margin="{TemplateBinding IconMargin}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <!-- antd's default indicator is four dots in a ring, not an arc. -->
                            <Grid x:Name="Spinner"
                                  Width="14" Height="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Grid.RenderTransform>
                                <Ellipse Width="3" Height="3" Fill="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Ellipse Width="3" Height="3" Fill="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Ellipse Width="3" Height="3" Fill="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                <Ellipse Width="3" Height="3" Fill="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter x:Name="Label"
                                              ContentSource="Content"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>

                        <!-- Keyboard focus has to be visible: antd draws a 2px ring in controlOutline. -->
                        <Border x:Name="FocusRing"
                                Margin="-2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource Antd.controlOutline}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsDashed" Value="True">
                            <Setter TargetName="DashedOutline" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SolidOutline" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="IsDashed" Value="False">
                            <Setter TargetName="DashedOutline" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HasIcon" Value="True">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasIcon" Value="False">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Loading" Value="False">
                            <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Loading" Value="True">
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinnerStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Spinner"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360"
                                            Duration="0:0:1"
                                            RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinnerStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Input -->

    <Style x:Key="Antd.Input.ClearButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent">
                        <!-- Both shapes share the same 14x14 coordinate space: Stretch=None plus
                             Top/Left keeps the cross centred without measuring its own bounds. -->
                        <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Antd.colorTextQuaternary}" />
                            <Path Data="M4.7,4.7 L9.3,9.3 M9.3,4.7 L4.7,9.3"
                                  Stretch="None"
                                  Stroke="{DynamicResource Antd.colorBgContainer}"
                                  StrokeThickness="1.1"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Input}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Antd.colorPrimaryBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Input}">
                    <Grid>
                        <!-- The chrome Border owns padding and border thickness so the text box is
                             exactly controlHeight - 2*lineWidth - 2*padding, like antd. Drawing the
                             border as a sibling left the content 2px too tall and the padding
                             reported as 0 vertically. -->
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="PrefixHost"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Prefix}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0" />

                            <!-- Fill the padded area instead of centring by desired size: a
                                 TextBox host that only takes its desired height ends up taller
                                 than controlHeight - border - padding. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          Height="{TemplateBinding HostHeight}"
                                          VerticalContentAlignment="Top"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled" />

                            <TextBlock x:Name="PlaceholderText"
                                       Grid.Column="1"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding Placeholder}"
                                       Foreground="{TemplateBinding PlaceholderBrush}" />

                            <StackPanel x:Name="PART_Accessory" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter x:Name="SuffixHost"
                                                  Content="{TemplateBinding Suffix}"
                                                  VerticalAlignment="Center" />
                                <Button x:Name="PART_ClearButton"
                                        Style="{StaticResource Antd.Input.ClearButton}" />
                            </StackPanel>
                        </Grid>
                        </Border>

                        <Border x:Name="FocusRing"
                                Margin="-2"
                                IsHitTestVisible="False"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource Antd.controlOutline}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowPlaceholder" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HasPrefix" Value="True">
                            <Setter TargetName="PrefixHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasPrefix" Value="False">
                            <Setter TargetName="PrefixHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HasSuffix" Value="True">
                            <Setter TargetName="SuffixHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasSuffix" Value="False">
                            <Setter TargetName="SuffixHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="CanClear" Value="True">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CanClear" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsFocusedState" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocusedState" Value="False">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Icon -->

    <Style TargetType="{x:Type antd:Icon}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Icon}">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Grid.RenderTransform>
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="896" Height="896">
                                <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Spin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IconSpinStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IconSpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Divider -->

    <!-- Solid and dashed rules are separate elements because a Setter.Value cannot hold a
         TemplateBinding, and a local Visibility would beat the trigger. -->
    <Style TargetType="{x:Type antd:Divider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,24" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Divider}">
                    <Grid>
                        <Grid x:Name="HorizontalLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="LineLeftSolid" Grid.Column="0" Height="1" VerticalAlignment="Center"
                                       Fill="{TemplateBinding LineBrush}" />
                            <Rectangle x:Name="LineLeftDashed" Grid.Column="0" Height="1" VerticalAlignment="Center"
                                       Stroke="{TemplateBinding LineBrush}" StrokeThickness="1"
                                       StrokeDashArray="3 3" />

                            <ContentPresenter x:Name="TextHost" Grid.Column="1" Margin="16,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding TextBrush}"
                                              TextElement.FontWeight="{TemplateBinding TextFontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              MinHeight="{TemplateBinding TextLineHeight}" />

                            <Rectangle x:Name="LineRightSolid" Grid.Column="2" Height="1" VerticalAlignment="Center"
                                       Fill="{TemplateBinding LineBrush}" />
                            <Rectangle x:Name="LineRightDashed" Grid.Column="2" Height="1" VerticalAlignment="Center"
                                       Stroke="{TemplateBinding LineBrush}" StrokeThickness="1"
                                       StrokeDashArray="3 3" />
                        </Grid>

                        <Rectangle x:Name="VerticalLine" Width="1" HorizontalAlignment="Center"
                                   Fill="{TemplateBinding LineBrush}" Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="HorizontalLayout" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VerticalLine" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="TextHost" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Dashed" Value="True">
                            <Setter TargetName="LineLeftSolid" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LineRightSolid" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LineLeftDashed" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LineRightDashed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Dashed" Value="False">
                            <Setter TargetName="LineLeftSolid" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LineRightSolid" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LineLeftDashed" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LineRightDashed" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Tag -->

    <Style TargetType="{x:Type antd:Tag}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Tag}">
                    <Border Background="{TemplateBinding TagBackground}"
                            BorderBrush="{TemplateBinding TagBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding TagCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding TagForeground}"
                                              TextElement.FontSize="{TemplateBinding TagFontSize}" />
                            <Button x:Name="PART_CloseButton"
                                    Style="{StaticResource Antd.Input.ClearButton}"
                                    Width="10" Height="10" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Closable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Badge -->

    <!-- antd positions the count absolutely at the top right corner and offsets it by half its
         own size (translate(50%, -50%)). A proportional translate keeps that true for one, two
         and three digit counts, which a fixed margin cannot. -->
    <Style TargetType="{x:Type antd:Badge}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Badge}">
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />

                        <!-- A Canvas never measures its children, which is how antd keeps the
                             count out of the flow while still painting it over the corner. -->
                        <Canvas>
                        <Border x:Name="CountBadge"
                                Canvas.Right="0" Canvas.Top="0"
                                Height="20" MinWidth="20" Padding="6,0" CornerRadius="10"
                                Background="{TemplateBinding BadgeBackground}"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform
                                    X="{Binding ActualWidth, ElementName=CountBadge, Converter={StaticResource Antd.HalfRatio}}"
                                    Y="{Binding ActualHeight, ElementName=CountBadge, Converter={StaticResource Antd.NegHalfRatio}}" />
                            </Border.RenderTransform>
                            <TextBlock Text="{TemplateBinding DisplayText}"
                                       Foreground="{DynamicResource Antd.colorTextLightSolid}"
                                       FontSize="{TemplateBinding BadgeFontSize}"
                                       LineHeight="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Ellipse x:Name="DotBadge" Width="6" Height="6"
                                 Canvas.Right="0" Canvas.Top="0"
                                 Fill="{TemplateBinding BadgeBackground}"
                                 Visibility="Collapsed">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="3" Y="-3" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Dot" Value="True">
                            <Setter TargetName="DotBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CountBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Dot" Value="False">
                            <Setter TargetName="DotBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsBadgeVisible" Value="True">
                            <Setter TargetName="CountBadge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsBadgeVisible" Value="False">
                            <Setter TargetName="CountBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Avatar -->

    <Style TargetType="{x:Type antd:Avatar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Avatar}">
                    <Border Background="{TemplateBinding AvatarBackground}"
                            CornerRadius="{TemplateBinding AvatarCornerRadius}"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="AvatarImage" Source="{TemplateBinding Source}"
                                   Stretch="UniformToFill" Visibility="Collapsed" />
                            <ContentPresenter x:Name="AvatarText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding AvatarForeground}"
                                              TextElement.FontSize="{TemplateBinding AvatarFontSize}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasImage" Value="True">
                            <Setter TargetName="AvatarImage" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AvatarText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Empty -->

    <Style TargetType="{x:Type antd:Empty}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Empty}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
                        <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
                            <Canvas Width="896" Height="896">
                                <Path Data="{TemplateBinding Image}" Fill="{TemplateBinding ImageBrush}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{TemplateBinding Description}"
                                   Foreground="{TemplateBinding DescriptionBrush}"
                                   FontSize="{DynamicResource Antd.fontSize}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Spin -->

    <Style TargetType="{x:Type antd:Spin}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Spin}">
                    <Grid>
                        <ContentPresenter x:Name="SpinContent" Content="{TemplateBinding Content}" />
                        <Border x:Name="SpinMask" Background="{DynamicResource Antd.colorBgContainer}"
                                Opacity="0.5" Visibility="Collapsed" />
                        <StackPanel x:Name="SpinIndicator" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Grid x:Name="SpinDots"
                                  Width="{TemplateBinding IndicatorSize}" Height="{TemplateBinding IndicatorSize}"
                                  RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Grid.RenderTransform>
                                <Ellipse Width="4" Height="4" Fill="{TemplateBinding IndicatorBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Ellipse Width="4" Height="4" Fill="{TemplateBinding IndicatorBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Ellipse Width="4" Height="4" Fill="{TemplateBinding IndicatorBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                <Ellipse Width="4" Height="4" Fill="{TemplateBinding IndicatorBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="TipText" Text="{TemplateBinding Tip}" Margin="0,8,0,0"
                                       Foreground="{TemplateBinding TipBrush}"
                                       FontSize="{DynamicResource Antd.fontSize}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Spinning" Value="True">
                            <Setter TargetName="SpinIndicator" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinDots"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Spinning" Value="False">
                            <Setter TargetName="SpinIndicator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="SpinMask" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SpinContent" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="ShowsTip" Value="False">
                            <Setter TargetName="TipText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SpinIndicator" Property="VerticalAlignment" Value="Center" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Statistic -->

    <Style TargetType="{x:Type antd:Statistic}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Statistic}">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}"
                                   Foreground="{TemplateBinding TitleBrush}"
                                   FontSize="{DynamicResource Antd.fontSize}"
                                   Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Prefix}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding ValueBrush}"
                                              TextElement.FontSize="{TemplateBinding ValueFontSize}" />
                            <TextBlock Text="{TemplateBinding ValueText}"
                                       Foreground="{TemplateBinding ValueBrush}"
                                       FontSize="{TemplateBinding ValueFontSize}"
                                       FontWeight="Normal" VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding Suffix}" VerticalAlignment="Center"
                                              Margin="4,0,0,0"
                                              TextElement.Foreground="{TemplateBinding ValueBrush}"
                                              TextElement.FontSize="{DynamicResource Antd.fontSize}" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Segmented -->

    <Style x:Key="Antd.Segmented.Item" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemRoot" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Antd.colorBgElevated}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextSecondary}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Segmented}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Antd.Segmented.Item}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Segmented}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding TrackCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress and Skeleton draw themselves; these styles only fix the rendering mode. -->

    <Style TargetType="{x:Type antd:Progress}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style TargetType="{x:Type antd:Skeleton}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- ============================================================ FloatButton -->

    <Style TargetType="{x:Type antd:FloatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:FloatButton}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <StackPanel x:Name="FloatContent" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="12,8">
                            <ContentPresenter Content="{TemplateBinding Icon}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="FloatDescription" Text="{TemplateBinding Description}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowsDescription" Value="True">
                            <Setter TargetName="FloatDescription" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FloatContent" Property="Orientation" Value="Vertical" />
                        </Trigger>
                        <Trigger Property="ShowsDescription" Value="False">
                            <Setter TargetName="FloatDescription" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FloatContent" Property="Orientation" Value="Horizontal" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Watermark -->

    <Style TargetType="{x:Type antd:Watermark}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Watermark}">
                    <Border Background="{TemplateBinding TileBrush}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Grid -->

    <Style TargetType="{x:Type antd:Col}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Col}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Row}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type antd:Flex}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================================================ Layout -->

    <Style TargetType="{x:Type antd:Layout}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type antd:Sider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Sider}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{DynamicResource Antd.colorText}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Header}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Header}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource Antd.colorText}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Footer}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Footer}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{DynamicResource Antd.colorText}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Content}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Content}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{DynamicResource Antd.colorText}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ InputNumber -->

    <Style x:Key="Antd.Spinner.Up" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" CornerRadius="2,2,0,0">
                        <Path Data="M0,4 L3.5,0.5 L7,4" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=antd:InputNumber}}"
                              StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Antd.Spinner.Down" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" CornerRadius="0,0,2,2">
                        <Path Data="M0,0.5 L3.5,4 L7,0.5" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=antd:InputNumber}}"
                              StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:InputNumber}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:InputNumber}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="0"
                                          Height="{TemplateBinding HostHeight}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />

                            <Grid x:Name="PART_Spinner" Grid.Column="1" Width="18" Margin="0,1,1,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <RepeatButton x:Name="PART_UpButton" Grid.Row="0" Style="{StaticResource Antd.Spinner.Up}" />
                                <RepeatButton x:Name="PART_DownButton" Grid.Row="1" Style="{StaticResource Antd.Spinner.Down}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Checkbox -->

    <Style TargetType="{x:Type antd:Checkbox}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Checkbox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="{TemplateBinding BoxSize}" Height="{TemplateBinding BoxSize}"
                                Background="{TemplateBinding BoxBrush}"
                                BorderBrush="{TemplateBinding BoxBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{theme:CornerRadius borderRadiusXS}"
                                VerticalAlignment="Center">
                            <Grid>
                                <Path x:Name="CheckMark" Data="M2.5,6 L5,8.5 L9.5,3.5" Stretch="None"
                                      Stroke="{TemplateBinding CheckBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="Indeterminate" Data="M3,6 L9,6" Stretch="None"
                                      Stroke="{TemplateBinding CheckBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Radio -->

    <Style TargetType="{x:Type antd:Radio}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Radio}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="{TemplateBinding RingSize}" Height="{TemplateBinding RingSize}" VerticalAlignment="Center">
                            <Ellipse Stroke="{TemplateBinding RingBrush}" StrokeThickness="1" Fill="Transparent" />
                            <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{TemplateBinding DotBrush}" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="RadioDot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Switch -->

    <Style TargetType="{x:Type antd:Switch}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Switch}">
                    <Border Width="{TemplateBinding TrackWidth}" Height="{TemplateBinding TrackHeight}"
                            Background="{TemplateBinding TrackBrush}"
                            CornerRadius="{TemplateBinding TrackCornerRadius}">
                        <Grid>
                            <TextBlock x:Name="SwitchText" Text="{TemplateBinding ActiveText}"
                                       Foreground="White" FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse x:Name="SwitchThumb" Width="{TemplateBinding ThumbSize}" Height="{TemplateBinding ThumbSize}"
                                     Fill="{TemplateBinding ThumbBrush}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="SwitchText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Rate -->

    <Style TargetType="{x:Type antd:Rate}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- ============================================================ Slider -->

    <Style x:Key="Antd.Slider.Decrease" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{DynamicResource Antd.colorPrimary}"
                            Height="{Binding TrackThickness, RelativeSource={RelativeSource AncestorType=antd:Slider}}"
                            CornerRadius="2" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Antd.Slider.Increase" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{DynamicResource Antd.colorFillSecondary}"
                            Height="{Binding TrackThickness, RelativeSource={RelativeSource AncestorType=antd:Slider}}"
                            CornerRadius="2" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Antd.Slider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse Fill="{DynamicResource Antd.colorPrimary}"
                             Stroke="{DynamicResource Antd.colorBgContainer}" StrokeThickness="2"
                             Width="{Binding ThumbSize, RelativeSource={RelativeSource AncestorType=antd:Slider}}"
                             Height="{Binding ThumbSize, RelativeSource={RelativeSource AncestorType=antd:Slider}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Slider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Slider}">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Antd.Slider.Decrease}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Antd.Slider.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Antd.Slider.Increase}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Select -->

    <Style x:Key="Antd.Select.Item" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemRoot" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Antd.controlItemBgHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Antd.controlItemBgActive}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Select}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Antd.Select.Item}" />
        <Setter Property="MaxDropDownHeight" Value="256" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Select}">
                    <Grid>
                        <Border x:Name="SelectRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- ComboBox opens from a ToggleButton in WPF's default template; a custom
                                     template has to provide one or clicking the field does nothing. -->
                                <ToggleButton x:Name="PART_Toggle" Grid.ColumnSpan="3"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="SelectionHost" Grid.Column="0"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  VerticalAlignment="Center" />

                                <StackPanel x:Name="PART_TagHost" Grid.Column="0" Orientation="Horizontal"
                                            Visibility="Collapsed" Margin="0,3,0,3" />

                                <TextBlock x:Name="PlaceholderHost" Grid.Column="0"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{TemplateBinding PlaceholderBrush}"
                                           VerticalAlignment="Center" Visibility="Collapsed" />

                                <Button x:Name="PART_ClearButton" Grid.Column="1"
                                        Style="{StaticResource Antd.Input.ClearButton}"
                                        Margin="0,0,4,0" Visibility="Collapsed" />

                                <Path Grid.Column="2" Data="M0,0 L4,4 L8,0" Stretch="None"
                                      Stroke="{TemplateBinding ArrowBrush}" StrokeThickness="1.2"
                                      Margin="0,1,10,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 16px shadow gutter: the offset gives the 4px gap back, so the panel still
                             sits 4px under the field. -->
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                               Focusable="False" StaysOpen="False"
                               VerticalOffset="4">
                            <!-- The 16px margin reserves room for the shadow; the transform cancels it so the
                                 panel still lines up with the field instead of drifting right and down. -->
                            <Border Margin="16"
                                    RenderTransformOrigin="0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1" CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                    Padding="4"
                                    Effect="{StaticResource Antd.Effect.Popup}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-16" Y="-16" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="SearchHost" Grid.Row="0" Visibility="Collapsed" Margin="2,2,2,4">
                                        <TextBox x:Name="PART_SearchBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center" />
                                        <TextBlock x:Name="PART_SearchWatermark"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   Visibility="Collapsed"
                                                   Foreground="{DynamicResource Antd.colorTextPlaceholder}" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Filterable" Value="True">
                            <Setter TargetName="SearchHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_SearchWatermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasSelection" Value="False">
                            <Setter TargetName="PlaceholderHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasSelection" Value="True">
                            <Setter TargetName="PlaceholderHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectionHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Declared after HasSelection so it wins: tags replace the single-value presenter. -->
                        <Trigger Property="IsMultiple" Value="True">
                            <Setter TargetName="SelectionHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TagHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CanClearSelection" Value="True">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CanClearSelection" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SelectRoot" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Form -->

    <Style TargetType="{x:Type antd:Form}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type antd:FormItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:FormItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PART_LabelColumn" Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="PART_LabelRow" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="RequiredMark" Text="*" Margin="0,0,4,0"
                                       Foreground="{TemplateBinding RequiredBrush}" Visibility="Collapsed" />
                            <TextBlock Text="{TemplateBinding Label}"
                                       Foreground="{TemplateBinding LabelBrush}"
                                       FontSize="{TemplateBinding FontSize}" />
                        </StackPanel>

                        <ContentPresenter x:Name="PART_Content" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                          HorizontalAlignment="Stretch" />

                        <TextBlock x:Name="PART_Message" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{TemplateBinding ActiveMessage}"
                                   Foreground="{TemplateBinding MessageBrush}"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasLabel" Value="True">
                            <Setter TargetName="PART_LabelRow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Required" Value="True">
                            <Setter TargetName="RequiredMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasMessage" Value="True">
                            <Setter TargetName="PART_Message" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ AutoComplete -->

    <Style x:Key="Antd.AutoComplete.Item" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemRoot" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Antd.controlItemBgHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource Antd.controlItemBgActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:AutoComplete}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:AutoComplete}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBox x:Name="PART_EditableTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         FontSize="{TemplateBinding FontSize}"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}"
                                         FocusVisualStyle="{x:Null}" />

                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Antd.colorTextPlaceholder}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                                                        Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ListBox x:Name="PART_Suggestions"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource Antd.AutoComplete.Item}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowPlaceholder" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Calendar -->

    <Style x:Key="Antd.Calendar.Nav" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="NavRoot" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Antd.Calendar.Day" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="DayRoot" Background="Transparent" CornerRadius="4" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DayRoot" Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DayRoot" Property="Background" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextLightSolid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOutsideMonth}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextDisabled}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextDisabled}" />
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <!-- Last so it beats the today/outside colours: white on the primary fill. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextLightSolid}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type antd:Calendar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Antd.colorBgContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Antd.colorBorderSecondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Calendar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <StackPanel Margin="{TemplateBinding Padding}">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{TemplateBinding MonthLabel}"
                                           FontSize="{DynamicResource Antd.fontSizeLG}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Antd.colorTextHeading}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="PART_PreviousMonth" Style="{StaticResource Antd.Calendar.Nav}">
                                        <Path Data="M6,0 L1,5 L6,10" Stretch="None" StrokeThickness="1.4"
                                              Stroke="{DynamicResource Antd.colorTextSecondary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button x:Name="PART_NextMonth" Style="{StaticResource Antd.Calendar.Nav}">
                                        <Path Data="M1,0 L6,5 L1,10" Stretch="None" StrokeThickness="1.4"
                                              Stroke="{DynamicResource Antd.colorTextSecondary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{TemplateBinding WeekDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"
                                                   FontSize="{DynamicResource Antd.fontSizeSM}"
                                                   Foreground="{DynamicResource Antd.colorTextSecondary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ListBox x:Name="PART_DayGrid"
                                     Height="196"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{TemplateBinding Days}"
                                     ItemContainerStyle="{StaticResource Antd.Calendar.Day}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Day}"
                                                   FontSize="{DynamicResource Antd.fontSize}"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ DatePicker -->

    <Style TargetType="{x:Type antd:DatePicker}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:DatePicker}">
                    <Grid>
                        <Border x:Name="PART_Field"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ValueText"
                                           Grid.Column="0"
                                           Text="{TemplateBinding DisplayText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock x:Name="PlaceholderText"
                                           Grid.Column="0"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Antd.colorTextPlaceholder}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PART_ClearButton"
                                            Style="{StaticResource Antd.Input.ClearButton}"
                                            Margin="0,0,6,0"
                                            Visibility="Collapsed" />
                                    <Path Data="M0,1.5 L10,1.5 M3,0 L3,3 M7,0 L7,3 M0.5,1.5 L0.5,9.5 L9.5,9.5 L9.5,1.5 Z"
                                          Stretch="None"
                                          Stroke="{DynamicResource Antd.colorTextTertiary}"
                                          StrokeThickness="1"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                                                        Padding="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <antd:Calendar x:Name="PART_Calendar"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       Padding="8"
                                                       Width="264" />
                                        <antd:Calendar x:Name="PART_EndCalendar"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       Padding="8"
                                                       Width="264"
                                                       Margin="8,0,0,0"
                                                       Visibility="Collapsed" />
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource Antd.colorSplit}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,8,0,0"
                                            Padding="0,4,0,0">
                                        <antd:Button x:Name="PART_Today"
                                                     Content=""
                                                     HorizontalAlignment="Right"
                                                     Variant="Link"
                                                     Size="Small" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowPlaceholder" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CanClear" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="CanClear" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Field" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Splitter -->

    <Style TargetType="{x:Type antd:Splitter}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Splitter}">
                    <!-- The bar is thin but the hit area is 10px, so it is draggable without
                         looking heavy. -->
                    <Grid Background="Transparent" MinWidth="10" MinHeight="10">
                        <Rectangle x:Name="VerticalBar"
                                   Width="{TemplateBinding BarThickness}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Fill="{TemplateBinding BarBrush}" />
                        <Rectangle x:Name="HorizontalBar"
                                   Height="{TemplateBinding BarThickness}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   Fill="{TemplateBinding BarBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="VerticalBar" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HorizontalBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Affix -->

    <Style TargetType="{x:Type antd:Affix}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Affix}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ BorderBeam -->

    <Style TargetType="{x:Type antd:BorderBeam}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- Painting happens in OnRender; the template only needs to exist so the
                     control has a visual to draw into. -->
                <ControlTemplate TargetType="{x:Type antd:BorderBeam}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Tree -->

    <BooleanToVisibilityConverter x:Key="Antd.BoolToVisibility" />

    <Style x:Key="Antd.Tree.Expander" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent">
                        <Path x:Name="Caret"
                              Data="M3.2,2.2 L8,6.5 L3.2,10.8"
                              Stretch="None"
                              Stroke="{DynamicResource Antd.colorTextSecondary}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caret" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Antd.Tree.ItemContainer" TargetType="{x:Type TreeViewItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="4"
                                Height="26"
                                Padding="0,0,4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander"
                                              Style="{StaticResource Antd.Tree.Expander}"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />

                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>

                        <!-- antd indents 24 per level; the expander already covers 20 of it. -->
                        <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Antd.colorPrimaryBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <HierarchicalDataTemplate x:Key="Antd.Tree.ItemTemplate"
                              DataType="{x:Type antd:TreeItem}"
                              ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <antd:Checkbox x:Name="NodeCheck"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           IsChecked="{Binding IsChecked, Mode=TwoWay}"
                           Visibility="{Binding Checkable, RelativeSource={RelativeSource AncestorType={x:Type antd:Tree}}, Converter={StaticResource Antd.BoolToVisibility}}" />
            <ContentPresenter Content="{Binding Header}" VerticalAlignment="Center" />
        </StackPanel>
    </HierarchicalDataTemplate>

    <Style TargetType="{x:Type antd:Tree}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Antd.fontSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Antd.Tree.ItemContainer}" />
        <Setter Property="ItemTemplate" Value="{StaticResource Antd.Tree.ItemTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Tree}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False"
                                      CanContentScroll="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ TimePicker -->

    <Style x:Key="Antd.TimePicker.Column" TargetType="{x:Type ListBox}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="196" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Cell" Background="Transparent" CornerRadius="4" Margin="2,1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Antd.colorPrimaryBg}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:TimePicker}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:TimePicker}">
                    <Grid>
                        <Border x:Name="PART_Field"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ValueText" Grid.Column="0"
                                           Text="{TemplateBinding DisplayText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" />

                                <TextBlock x:Name="PlaceholderText" Grid.Column="0"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Antd.colorTextPlaceholder}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PART_ClearButton"
                                            Style="{StaticResource Antd.Input.ClearButton}"
                                            Margin="0,0,6,0"
                                            Visibility="Collapsed" />
                                    <Path Data="M7,0 A7,7 0 1 1 6.99,0 M7,3.5 L7,7.5 L9.6,9.2"
                                          Stretch="None"
                                          Stroke="{DynamicResource Antd.colorTextTertiary}"
                                          StrokeThickness="1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                                                        Padding="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ListBox x:Name="PART_Hours"
                                                 Style="{StaticResource Antd.TimePicker.Column}"
                                                 ItemsSource="{TemplateBinding Hours}" />
                                        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0"
                                                   Foreground="{DynamicResource Antd.colorTextTertiary}" />
                                        <ListBox x:Name="PART_Minutes"
                                                 Style="{StaticResource Antd.TimePicker.Column}"
                                                 ItemsSource="{TemplateBinding Sixty}" />
                                        <TextBlock x:Name="SecondsSeparator" Text=":" VerticalAlignment="Center" Margin="2,0"
                                                   Foreground="{DynamicResource Antd.colorTextTertiary}" />
                                        <ListBox x:Name="PART_Seconds"
                                                 Style="{StaticResource Antd.TimePicker.Column}"
                                                 ItemsSource="{TemplateBinding Sixty}" />
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource Antd.colorSplit}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,8,0,0"
                                            Padding="0,4,0,0">
                                        <antd:Button x:Name="PART_Now"
                                                     Content="Now"
                                                     HorizontalAlignment="Right"
                                                     Variant="Link"
                                                     Size="Small" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowPlaceholder" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CanClear" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="CanClear" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="ShowSeconds" Value="False">
                            <Setter TargetName="SecondsSeparator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Seconds" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Mentions -->

    <Style TargetType="{x:Type antd:Mentions}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Mentions}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <TextBox x:Name="PART_Editor"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                         FontSize="{TemplateBinding FontSize}"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}"
                                         FocusVisualStyle="{x:Null}" />

                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Antd.colorTextPlaceholder}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Relative"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                    Padding="4"
                                    MinWidth="160">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ListBox x:Name="PART_Suggestions"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource Antd.AutoComplete.Item}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowPlaceholder" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Upload -->

    <Style TargetType="{x:Type antd:Upload}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Upload}">
                    <StackPanel>
                        <Grid x:Name="PART_DropZone" Background="Transparent" Cursor="Hand">
                            <Rectangle x:Name="ZoneBorder"
                                       RadiusX="8" RadiusY="8"
                                       Stroke="{DynamicResource Antd.colorBorder}"
                                       StrokeThickness="1"
                                       StrokeDashArray="4 3"
                                       Fill="{DynamicResource Antd.colorBgContainer}" />
                            <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ZoneTitle"
                                           Text="{TemplateBinding ButtonText}"
                                           HorizontalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{DynamicResource Antd.colorText}" />
                                <TextBlock x:Name="ZoneHint"
                                           Text="{TemplateBinding Hint}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Antd.colorTextDescription}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="FileList"
                                      ItemsSource="{Binding Files, RelativeSource={RelativeSource TemplatedParent}}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Antd.colorFillQuaternary}"
                                            CornerRadius="6"
                                            Margin="0,0,0,6"
                                            Padding="10,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Antd.colorText}" />

                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Antd.colorTextTertiary}" />

                                                <antd:UploadRemoveButton Grid.Column="2" />
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="{x:Type StackPanel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <ProgressBar Height="2"
                                                             Maximum="100"
                                                             Value="{Binding Progress, Mode=OneWay}"
                                                             BorderThickness="0"
                                                             Background="{DynamicResource Antd.colorFillSecondary}"
                                                             Foreground="{DynamicResource Antd.colorPrimary}" />

                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="12"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Antd.colorTextTertiary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasFiles" Value="False">
                            <Setter TargetName="FileList" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDraggingOver" Value="True">
                            <Setter TargetName="ZoneBorder" Property="Stroke" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="ZoneBorder" Property="Fill" Value="{DynamicResource Antd.colorPrimaryBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:TransferMoveButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:TransferMoveButton}">
                    <Border x:Name="MoveRoot"
                            Background="{DynamicResource Antd.colorBgContainer}"
                            BorderBrush="{DynamicResource Antd.colorBorder}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MoveRoot" Property="BorderBrush" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextDisabled}" />
                            <Setter TargetName="MoveRoot" Property="BorderBrush" Value="{DynamicResource Antd.colorBorderDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Transfer -->

    <Style x:Key="Antd.Transfer.List" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="196" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Cell" Background="Transparent" CornerRadius="4" Padding="8,0">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Antd.colorPrimaryBg}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Transfer}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Transfer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource Antd.colorBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="{DynamicResource Antd.colorBgContainer}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{DynamicResource Antd.colorFillQuaternary}"
                                        CornerRadius="5,5,0,0"
                                        Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding SourceTitle}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Antd.colorText}" />
                                        <TextBlock Text="{TemplateBinding SourceCount}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Antd.colorTextTertiary}" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="PART_SourceList"
                                         Style="{StaticResource Antd.Transfer.List}"
                                         SelectionMode="Extended" />
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <antd:TransferMoveButton ToTarget="True">
                                <Path Data="M3.5,2 L8.5,7 L3.5,12"
                                      Stretch="None"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=antd:TransferMoveButton}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </antd:TransferMoveButton>
                            <antd:TransferMoveButton ToTarget="False" Margin="0,6,0,0">
                                <Path Data="M8.5,2 L3.5,7 L8.5,12"
                                      Stretch="None"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=antd:TransferMoveButton}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </antd:TransferMoveButton>
                        </StackPanel>

                        <Border Grid.Column="2"
                                BorderBrush="{DynamicResource Antd.colorBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="{DynamicResource Antd.colorBgContainer}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{DynamicResource Antd.colorFillQuaternary}"
                                        CornerRadius="5,5,0,0"
                                        Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding TargetTitle}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Antd.colorText}" />
                                        <TextBlock Text="{TemplateBinding TargetCount}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Antd.colorTextTertiary}" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="PART_TargetList"
                                         Style="{StaticResource Antd.Transfer.List}"
                                         SelectionMode="Extended" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ ColorPicker -->

    <theme:RatioConverter x:Key="Antd.SquareX" Ratio="180" />
    <theme:RatioConverter x:Key="Antd.SquareY" Ratio="150" />
    <theme:RatioConverter x:Key="Antd.HueY" Ratio="150" />

    <Style TargetType="{x:Type antd:ColorPresetButton}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:ColorPresetButton}">
                    <Border Background="{TemplateBinding Swatch}"
                            CornerRadius="3"
                            BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                            BorderThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:ColorPicker}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:ColorPicker}">
                    <Grid>
                        <Border x:Name="PART_Field"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="16" Height="16"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="{TemplateBinding SwatchBrush}"
                                        BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                        BorderThickness="1" />

                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding HexText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" />

                                <Button x:Name="PART_ClearButton"
                                        Grid.Column="2"
                                        Style="{StaticResource Antd.Input.ClearButton}"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                                                        Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Saturation runs left to right, value bottom to top. -->
                                        <Grid x:Name="PART_Saturation"
                                              Grid.Column="0"
                                              Width="180" Height="150"
                                              ClipToBounds="True">
                                            <Rectangle Fill="{TemplateBinding HueBrush}" />
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0" />
                                                        <GradientStop Color="#FF000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <Ellipse Width="10" Height="10"
                                                     Fill="Transparent"
                                                     Stroke="White"
                                                     StrokeThickness="2"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Margin="-5,-5,0,0"
                                                     IsHitTestVisible="False">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform
                                                        X="{Binding MarkerX, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Antd.SquareX}}"
                                                        Y="{Binding MarkerY, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Antd.SquareY}}" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>

                                        <Grid x:Name="PART_Hue"
                                              Grid.Column="1"
                                              Width="12" Height="150"
                                              Margin="12,0,0,0"
                                              ClipToBounds="True">
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                                        <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                                        <GradientStop Color="#FF00FF00" Offset="0.33" />
                                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                                        <GradientStop Color="#FF0000FF" Offset="0.67" />
                                                        <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <Border Height="3"
                                                    Background="White"
                                                    BorderBrush="{DynamicResource Antd.colorBorder}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-1,0,0"
                                                    IsHitTestVisible="False">
                                                <Border.RenderTransform>
                                                    <TranslateTransform
                                                        X="0"
                                                        Y="{Binding HueOffset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Antd.HueY}}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <ItemsControl ItemsSource="{TemplateBinding Presets}" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <antd:ColorPresetButton Swatch="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="CanClear" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CanClear" Value="True">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Table -->

    <Style x:Key="Antd.Table.ColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Antd.fontSize}" />
        <Setter Property="Padding" Value="16,16" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border x:Name="Head"
                            Background="{DynamicResource Antd.colorFillAlter}"
                            BorderBrush="{DynamicResource Antd.colorSplit}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />

                            <Path x:Name="SortArrow"
                                  Grid.Column="1"
                                  Data="M0,5 L4,1 L8,5"
                                  Stretch="None"
                                  Stroke="{DynamicResource Antd.colorPrimary}"
                                  StrokeThickness="1.4"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Head" Property="Background" Value="{DynamicResource Antd.colorFillSecondary}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="4" CenterY="3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Antd.Table.Cell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource Antd.colorSplit}"
                            BorderThickness="0,0,0,1"
                            Padding="16,16">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Antd.Table.Row" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource Antd.colorBgContainer}" />
        <Setter Property="MinHeight" Value="55" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Antd.colorFillAlter}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Antd.colorPrimaryBg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Based on the framework DataGrid style: we only repaint it, so sorting, resizing,
         column virtualisation and keyboard navigation stay intact. -->
    <Style TargetType="{x:Type antd:Table}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Antd.fontSize}" />
        <Setter Property="Background" Value="{DynamicResource Antd.colorBgContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Antd.colorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Antd.colorSplit}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Antd.colorSplit}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Antd.Table.ColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource Antd.Table.Cell}" />
        <Setter Property="RowStyle" Value="{StaticResource Antd.Table.Row}" />
        <Setter Property="ColumnWidth" Value="*" />
    </Style>

    <!-- ============================================================ TreeSelect -->

    <Style TargetType="{x:Type antd:TreeSelect}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:TreeSelect}">
                    <Grid>
                        <Border x:Name="PART_Field"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ValueText" Grid.Column="0"
                                           Text="{TemplateBinding DisplayText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock x:Name="PlaceholderText" Grid.Column="0"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Antd.colorTextPlaceholder}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" />

                                <Button x:Name="PART_ClearButton" Grid.Column="1"
                                        Style="{StaticResource Antd.Input.ClearButton}"
                                        Margin="0,0,6,0"
                                        Visibility="Collapsed" />

                                <Path Grid.Column="2"
                                      Data="M0,0 L4,4 L8,0"
                                      Stretch="None"
                                      Stroke="{DynamicResource Antd.colorTextTertiary}"
                                      StrokeThickness="1.2"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                                                        Padding="8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <antd:Tree x:Name="PART_Tree" ItemsSource="{TemplateBinding ItemsSource}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowPlaceholder" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CanClear" Value="True">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Cascader -->

    <Style TargetType="{x:Type antd:Cascader}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Cascader}">
                    <Grid>
                        <Border x:Name="PART_Field"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ValueText" Grid.Column="0"
                                           Text="{TemplateBinding DisplayText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock x:Name="PlaceholderText" Grid.Column="0"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Antd.colorTextPlaceholder}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" />

                                <Button x:Name="PART_ClearButton" Grid.Column="1"
                                        Style="{StaticResource Antd.Input.ClearButton}"
                                        Margin="0,0,6,0"
                                        Visibility="Collapsed" />

                                <Path Grid.Column="2"
                                      Data="M0,0 L4,4 L8,0"
                                      Stretch="None"
                                      Stroke="{DynamicResource Antd.colorTextTertiary}"
                                      StrokeThickness="1.2"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="{theme:CornerRadius borderRadiusLG}"
                                                                        Padding="4">
                                <StackPanel x:Name="PART_Columns" Orientation="Horizontal" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlaceholder" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowPlaceholder" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ValueText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CanClear" Value="True">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Tabs -->

    <Style TargetType="{x:Type antd:TabsItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="FontSize" Value="{DynamicResource Antd.fontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <!-- antd pins the label row at 46 (12 + 22 + 12). WPF's default line box for 14px
             text is 17.6, so the height has to be stated instead of derived from padding. -->
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="Margin" Value="0,0,32,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:TabsItem}">
                    <!-- The strip hairline sits 16 below the nav, so the ink bar has to be drawn
                         against the item's own box, not inside its padding. -->
                    <Grid Background="Transparent">
                        <Border Padding="{TemplateBinding Padding}">
                            <!-- Header, not Content: the content belongs to the panel host. -->
                            <ContentPresenter x:Name="Label"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <Border x:Name="Ink"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Antd.colorPrimary}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="Ink" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimaryHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Tabs}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Tabs}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Nav: 46 tall labels sitting on a hairline. The line is a sibling at the
                             bottom of the row so the 2px ink bar can paint over it; nesting it in a
                             Border and pulling the items up by 1px buried the line instead. -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Border VerticalAlignment="Bottom"
                                    Height="1"
                                    Background="{DynamicResource Antd.colorSplit}" />
                            <WrapPanel IsItemsHost="True"
                                       Orientation="Horizontal"
                                       Background="Transparent"
                                       HorizontalAlignment="Left" />
                        </Grid>

                        <ContentPresenter Grid.Row="1"
                                          x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Card -->

    <Style TargetType="{x:Type antd:Card}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Card}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="Head"
                                    Grid.Row="0"
                                    Height="56"
                                    Padding="24,0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Antd.colorSplit}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Title"
                                                      VerticalAlignment="Center"
                                                      TextElement.FontSize="{DynamicResource Antd.fontSizeLG}"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{DynamicResource Antd.colorTextHeading}" />

                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Extra"
                                                      VerticalAlignment="Center"
                                                      Margin="16,0,0,0"
                                                      TextElement.FontSize="{DynamicResource Antd.fontSize}" />
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1" Margin="24" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="Head" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Collapse -->

    <Style TargetType="{x:Type antd:CollapseItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:CollapseItem}">
                    <Border x:Name="ItemRoot"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Antd.colorBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="PART_Header"
                                    Grid.Row="0"
                                    Height="46"
                                    Padding="16,0"
                                    Background="{DynamicResource Antd.colorFillAlter}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="Arrow"
                                          Grid.Column="0"
                                          Data="M2,0 L6,4 L2,8"
                                          Stretch="None"
                                          Stroke="{DynamicResource Antd.colorTextDescription}"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5" />

                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,0,0"
                                                      TextElement.FontSize="{DynamicResource Antd.fontSize}"
                                                      TextElement.Foreground="{DynamicResource Antd.colorText}" />
                                </Grid>
                            </Border>

                            <Border x:Name="Body"
                                    Grid.Row="1"
                                    Padding="16"
                                    Visibility="Collapsed"
                                    Background="Transparent">
                                <ContentPresenter TextElement.FontSize="{DynamicResource Antd.fontSize}"
                                                  TextElement.Foreground="{DynamicResource Antd.colorText}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="4" CenterY="4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="ItemRoot" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFirst" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="CornerRadius" Value="7,7,0,0" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Collapse}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Collapse}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ List -->

    <Style TargetType="{x:Type antd:ListItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:ListItem}">
                    <Border x:Name="RowRoot"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Antd.colorSplit}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="RowRoot" Property="BorderThickness" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:List}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:List}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Tooltip -->

    <Style TargetType="{x:Type antd:Tooltip}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Tooltip}">
                    <Grid Background="Transparent">
                        <ContentPresenter />

                        <!-- A hover bubble must not steal the mouse, otherwise moving onto it
                             fires MouseLeave on the trigger and it would close instantly. -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="True">
                            <Border Background="{DynamicResource Antd.colorBgSpotlight}"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    MaxWidth="250">
                                <TextBlock Text="{TemplateBinding Text}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="{DynamicResource Antd.colorTextLightSolid}" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Popover -->

    <Style TargetType="{x:Type antd:Popover}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Popover}">
                    <Grid Background="Transparent">
                        <ContentPresenter />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    MaxWidth="300">
                                <StackPanel>
                                    <TextBlock x:Name="TitleText"
                                               Text="{TemplateBinding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                                    <ContentPresenter ContentSource="Body"
                                                      TextElement.FontSize="14"
                                                      TextElement.Foreground="{DynamicResource Antd.colorText}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasTitle" Value="False">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Dropdown -->

    <Style x:Key="Antd.Dropdown.Item" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="MenuRow"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource Antd.controlItemBgHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource Antd.controlItemBgActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Dropdown}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Dropdown}">
                    <Grid Background="Transparent">
                        <ContentPresenter />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    MinWidth="120">
                                <ListBox x:Name="PART_Menu"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemsSource="{TemplateBinding ItemsSource}"
                                         ItemTemplate="{TemplateBinding ItemTemplate}"
                                         ItemContainerStyle="{StaticResource Antd.Dropdown.Item}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Breadcrumb -->

    <Style TargetType="{x:Type antd:BreadcrumbItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:BreadcrumbItem}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                        <TextBlock x:Name="Separator"
                                   Text="/"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{DynamicResource Antd.colorTextQuaternary}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Breadcrumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Breadcrumb}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Descriptions -->

    <Style TargetType="{x:Type antd:DescriptionsItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:DescriptionsItem}">
                    <Grid x:Name="Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="LabelCell" Grid.Column="0" Padding="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter ContentSource="Label"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.Foreground="{DynamicResource Antd.colorTextSecondary}" />
                                <TextBlock x:Name="Colon"
                                           Text=":"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ValueCell" Grid.Column="1" Padding="0,0,16,8">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{DynamicResource Antd.colorText}" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasLabel" Value="False">
                            <Setter TargetName="Colon" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Bordered mode: only right and bottom edges per cell, the frame draws
                             the left and top ones, so neighbours never stack two hairlines. -->
                        <DataTrigger Binding="{Binding Bordered, RelativeSource={RelativeSource AncestorType={x:Type antd:Descriptions}}}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Antd.colorBgContainer}" />
                            <Setter TargetName="LabelCell" Property="Background" Value="{DynamicResource Antd.colorFillAlter}" />
                            <Setter TargetName="LabelCell" Property="Padding" Value="16" />
                            <Setter TargetName="LabelCell" Property="BorderBrush" Value="{DynamicResource Antd.colorBorderSecondary}" />
                            <Setter TargetName="LabelCell" Property="BorderThickness" Value="0,0,1,1" />
                            <Setter TargetName="ValueCell" Property="Padding" Value="16" />
                            <Setter TargetName="ValueCell" Property="BorderBrush" Value="{DynamicResource Antd.colorBorderSecondary}" />
                            <Setter TargetName="ValueCell" Property="BorderThickness" Value="0,0,1,1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Descriptions}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <antd:DescriptionsPanel
                        Columns="{Binding Column, RelativeSource={RelativeSource AncestorType={x:Type antd:Descriptions}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Descriptions}">
                    <Border x:Name="Frame"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0">
                        <ItemsPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Bordered" Value="True">
                            <Setter TargetName="Frame" Property="BorderThickness" Value="1,1,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Timeline -->

    <Style TargetType="{x:Type antd:TimelineItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:TimelineItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Border x:Name="Rail"
                                    Width="2"
                                    Margin="0,14,0,-4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource Antd.colorSplit}" />
                            <Ellipse x:Name="Dot"
                                     Width="{TemplateBinding DotSize}"
                                     Height="{TemplateBinding DotSize}"
                                     Margin="0,4,0,0"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Center"
                                     Fill="{TemplateBinding DotBrush}" />
                        </Grid>

                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,20"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="Rail" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Timeline}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Timeline}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Steps -->

    <Style TargetType="{x:Type antd:StepsItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:StepsItem}">
                    <Grid VerticalAlignment="Top" Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Horizontal: icon on top, label under it, connector running right. -->
                        <StackPanel x:Name="HorizontalHost" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid Height="32">
                                <Grid x:Name="HIcon" Width="32" Height="32" HorizontalAlignment="Left">
                                    <Ellipse x:Name="HCircle"
                                             Fill="{DynamicResource Antd.colorBgContainer}"
                                             Stroke="{DynamicResource Antd.colorBorder}"
                                             StrokeThickness="1" />
                                    <TextBlock x:Name="HNumber"
                                               Text="{TemplateBinding Number}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource Antd.colorTextSecondary}" />
                                    <Path x:Name="HCheck"
                                          Data="M4,8 L6.5,10.5 L11,5"
                                          Stretch="None"
                                          Stroke="{DynamicResource Antd.colorTextLightSolid}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Grid>
                                <Border x:Name="HConnector"
                                        Height="1"
                                        Margin="40,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Antd.colorSplit}" />
                            </Grid>

                            <TextBlock Text="{TemplateBinding Title}"
                                       Margin="0,8,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource Antd.colorText}" />
                            <TextBlock x:Name="HDescription"
                                       Text="{TemplateBinding Description}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="{DynamicResource Antd.colorTextDescription}"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Vertical: icon on the left, label beside it, connector running down. -->
                        <Grid x:Name="VerticalHost" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="32" VerticalAlignment="Stretch">
                                <Grid x:Name="VIcon" Width="32" Height="32" VerticalAlignment="Top">
                                    <Ellipse x:Name="VCircle"
                                             Fill="{DynamicResource Antd.colorBgContainer}"
                                             Stroke="{DynamicResource Antd.colorBorder}"
                                             StrokeThickness="1" />
                                    <TextBlock x:Name="VNumber"
                                               Text="{TemplateBinding Number}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource Antd.colorTextSecondary}" />
                                    <Path x:Name="VCheck"
                                          Data="M4,8 L6.5,10.5 L11,5"
                                          Stretch="None"
                                          Stroke="{DynamicResource Antd.colorTextLightSolid}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Grid>
                                <Border x:Name="VConnector"
                                        Width="1"
                                        Margin="0,36,0,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource Antd.colorSplit}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,4,0,0">
                                <TextBlock Text="{TemplateBinding Title}"
                                           FontSize="14"
                                           Foreground="{DynamicResource Antd.colorText}" />
                                <TextBlock x:Name="VDescription"
                                           Text="{TemplateBinding Description}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="{DynamicResource Antd.colorTextDescription}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="HDescription" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VDescription" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="HDescription" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VDescription" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsVertical" Value="True">
                            <Setter TargetName="HorizontalHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VerticalHost" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="HConnector" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VConnector" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Status" Value="Process">
                            <Setter TargetName="HCircle" Property="Stroke" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="VCircle" Property="Stroke" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="HNumber" Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="VNumber" Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="HConnector" Property="Background" Value="{DynamicResource Antd.colorSplit}" />
                        </Trigger>

                        <Trigger Property="Status" Value="Finish">
                            <Setter TargetName="HCircle" Property="Fill" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="HCircle" Property="Stroke" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="VCircle" Property="Fill" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="VCircle" Property="Stroke" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="HNumber" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VNumber" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HCheck" Property="Visibility" Value="Visible" />
                            <Setter TargetName="VCheck" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HConnector" Property="Background" Value="{DynamicResource Antd.colorPrimaryBorder}" />
                        </Trigger>

                        <Trigger Property="Status" Value="Error">
                            <Setter TargetName="HCircle" Property="Stroke" Value="{DynamicResource Antd.colorError}" />
                            <Setter TargetName="VCircle" Property="Stroke" Value="{DynamicResource Antd.colorError}" />
                            <Setter TargetName="HNumber" Property="Foreground" Value="{DynamicResource Antd.colorError}" />
                            <Setter TargetName="VNumber" Property="Foreground" Value="{DynamicResource Antd.colorError}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Steps}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Steps}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Direction" Value="Vertical">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ Masonry -->

    <Style TargetType="{x:Type antd:Masonry}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <antd:MasonryPanel
                        Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type antd:Masonry}}}"
                        Gutter="{Binding Gutter, RelativeSource={RelativeSource AncestorType={x:Type antd:Masonry}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Masonry}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Pagination -->

    <Style TargetType="{x:Type antd:PaginationPageButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:PaginationPageButton}">
                    <Border x:Name="PageRoot"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PageRoot" Property="BorderBrush" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="PageRoot" Property="BorderBrush" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEllipsis" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextTertiary}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorTextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Pagination}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Pagination}">
                    <StackPanel x:Name="PART_Host" Orientation="Horizontal" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Carousel -->

    <Style TargetType="{x:Type antd:CarouselDotButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:CarouselDotButton}">
                    <Border x:Name="Dot"
                            CornerRadius="2"
                            Background="{DynamicResource Antd.colorTextQuaternary}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Antd.colorText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Carousel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Carousel}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid>
                            <ContentPresenter Content="{TemplateBinding SelectedItem}"
                                              Margin="24"
                                              TextElement.FontSize="14"
                                              TextElement.Foreground="{DynamicResource Antd.colorText}" />

                            <StackPanel x:Name="PART_Dots"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,12" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Image -->

    <Style TargetType="{x:Type antd:Image}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Image}">
                    <Grid Background="Transparent">
                        <Border CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True"
                                Background="{DynamicResource Antd.colorFillQuaternary}">
                            <Image Source="{TemplateBinding Source}"
                                   Stretch="{TemplateBinding Stretch}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               Placement="Center"
                               Focusable="False">
                            <Grid x:Name="PART_Mask" Background="#D9000000">
                                <Image Source="{TemplateBinding Source}"
                                       Stretch="Uniform"
                                       Margin="64"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Anchor -->

    <Style TargetType="{x:Type antd:AnchorLink}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Antd.colorText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Antd.FocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:AnchorLink}">
                    <Grid Background="Transparent">
                        <Border x:Name="Rail"
                                Width="2"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Antd.colorSplit}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:Anchor}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Anchor}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Menu -->

    <Style x:Key="Antd.Menu.Popup" TargetType="{x:Type antd:MenuNode}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:MenuNode}">
                    <Grid Background="Transparent">
                        <Border x:Name="Row"
                                Height="40"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                Cursor="Hand">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Path Data="M0,0 L4,4 L0,8"
                                      Stretch="None"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource Antd.colorTextTertiary}"
                                      StrokeThickness="1.2"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="90" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsExpanded}"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               Focusable="False">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    MinWidth="160">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Antd.colorPrimaryBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type antd:MenuNode}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:MenuNode}">
                    <StackPanel>
                        <Border x:Name="Row"
                                Height="40"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                Cursor="Hand">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Path x:Name="Caret"
                                      Data="M0,0 L4,4 L0,8"
                                      Stretch="None"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource Antd.colorTextTertiary}"
                                      StrokeThickness="1.2"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="Inline" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasChildren" Value="True">
                            <Setter TargetName="Caret" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Inline" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Caret" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="2" CenterY="4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Antd.colorFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Antd.colorPrimaryBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Antd.colorPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="PopupMode" Value="True">
                <Setter Property="Template" Value="{StaticResource Antd.Menu.Popup}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type antd:Menu}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Menu}">
                    <Border Background="{DynamicResource Antd.colorBgContainer}"
                            BorderBrush="{DynamicResource Antd.colorSplit}"
                            BorderThickness="0,0,0,1">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Mode" Value="Horizontal">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ Tour -->

    <Style TargetType="{x:Type antd:Tour}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Tour}">
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           Focusable="False">
                        <Canvas x:Name="PART_Mask" Background="Transparent">
                            <Path x:Name="PART_Spotlight"
                                  Fill="{DynamicResource Antd.colorBgMask}" />

                            <Border x:Name="PART_Card"
                                    Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="280">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentTitle, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                                    <TextBlock Text="{Binding CurrentDescription, RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="0,8,0,0"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Antd.colorTextSecondary}" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PositionText, RelativeSource={RelativeSource TemplatedParent}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Antd.colorTextTertiary}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <antd:Button x:Name="PART_Prev" Content="Prev" Size="Small" Margin="0,0,8,0" />
                                            <antd:Button x:Name="PART_Next" Content="Next" Size="Small" Variant="Primary" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <antd:Button x:Name="PART_Close"
                                         Content="Skip"
                                         Variant="Link"
                                         Size="Small"
                                         Canvas.Left="16"
                                         Canvas.Top="16" />
                        </Canvas>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Alert -->

    <Style TargetType="{x:Type antd:Alert}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Alert}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <antd:Icon x:Name="StatusIcon"
                                       Grid.Column="0"
                                       Size="{TemplateBinding IconSize}"
                                       Data="{TemplateBinding IconGeometry}"
                                       Foreground="{TemplateBinding IconBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="MessageText"
                                           Text="{TemplateBinding Message}"
                                           FontSize="{TemplateBinding MessageFontSize}"
                                           LineHeight="{TemplateBinding MessageLineHeight}"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DescriptionText"
                                           Text="{TemplateBinding Description}"
                                           FontSize="14"
                                           LineHeight="22"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,8,0,0"
                                           Visibility="{TemplateBinding DescriptionVisibility}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <ContentPresenter Content="{TemplateBinding Action}"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{TemplateBinding ActionVisibility}" />
                                <Border x:Name="PART_Close"
                                        Width="14" Height="14"
                                        Margin="10,0,0,0"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <antd:Icon Size="12" Data="{x:Static icons:AntdIcons.Close}" Foreground="{DynamicResource Antd.colorIcon}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDescription" Value="True">
                            <Setter TargetName="StatusIcon" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="StatusIcon" Property="Margin" Value="0,0,12,0" />
                            <Setter TargetName="PART_Close" Property="VerticalAlignment" Value="Top" />
                        </Trigger>
                        <Trigger Property="Closable" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Result -->

    <Style TargetType="{x:Type antd:Result}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Result}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Height="72" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <antd:Icon Size="72"
                                           Data="{TemplateBinding IconGeometry}"
                                           Foreground="{TemplateBinding IconBrush}"
                                           Visibility="{TemplateBinding IconVisibility}" />
                                <TextBlock Text="{TemplateBinding StatusText}"
                                           FontSize="64"
                                           FontWeight="Bold"
                                           LineHeight="72"
                                           LineStackingStrategy="BlockLineHeight"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding IconBrush}"
                                           Visibility="{TemplateBinding StatusTextVisibility}" />
                            </Grid>

                            <ContentPresenter x:Name="PART_TitleHost" Content="{TemplateBinding Title}"
                                              HorizontalAlignment="Center"
                                              TextElement.FontSize="24"
                                              TextElement.FontWeight="Normal"
                                              TextElement.Foreground="{DynamicResource Antd.colorText}"
                                              Visibility="{TemplateBinding TitleVisibility}" />

                            <TextBlock Text="{TemplateBinding SubTitle}"
                                       FontSize="14"
                                       LineHeight="22"
                                       LineStackingStrategy="BlockLineHeight"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource Antd.colorTextDescription}"
                                       Visibility="{TemplateBinding SubTitleVisibility}" />

                            <ContentPresenter Content="{TemplateBinding Extra}"
                                              HorizontalAlignment="Center"
                                              Margin="0,24,0,0"
                                              Visibility="{TemplateBinding ExtraVisibility}" />

                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Center"
                                              Margin="0,24,0,0"
                                              Visibility="{TemplateBinding ContentVisibility}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Modal -->

    <Style TargetType="{x:Type antd:Modal}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Modal}">
                    <Grid Background="Transparent">
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="True">
                            <Grid x:Name="PART_Surface" Background="Transparent">
                                <Rectangle x:Name="PART_Mask" Fill="{TemplateBinding MaskBrush}" />

                                <Border x:Name="PART_Card"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Effect="{StaticResource Antd.Effect.Elevated}"
                                        Focusable="True"
                                        KeyboardNavigation.TabNavigation="Cycle">
                                    <Grid Margin="24,20,24,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <ContentPresenter Content="{TemplateBinding Title}"
                                                              Margin="0,0,40,0"
                                                              VerticalAlignment="Center"
                                                              TextElement.FontSize="16"
                                                              TextElement.FontWeight="SemiBold"
                                                              TextElement.Foreground="{DynamicResource Antd.colorTextHeading}" />
                                            <Border x:Name="PART_Close"
                                                    Width="32" Height="32"
                                                    Margin="0,-8,-12,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="4"
                                                    Background="Transparent"
                                                    Cursor="Hand">
                                                <antd:Icon Size="14" Data="{x:Static icons:AntdIcons.Close}" Foreground="{DynamicResource Antd.colorIcon}" />
                                            </Border>
                                        </Grid>

                                        <ContentPresenter Grid.Row="1"
                                                          ContentSource="Content"
                                                          TextElement.FontSize="14"
                                                          TextElement.Foreground="{DynamicResource Antd.colorText}" />

                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{TemplateBinding DefaultFooterVisibility}">
                                                <antd:Button x:Name="PART_Cancel" Content="{TemplateBinding CancelText}"
                                                             Visibility="{TemplateBinding ShowCancel, Converter={StaticResource Antd.BoolToVisibility}}" />
                                                <antd:Button x:Name="PART_Ok"
                                                             Content="{TemplateBinding OkText}"
                                                             Variant="Primary"
                                                             Margin="8,0,0,0" />
                                            </StackPanel>
                                            <ContentPresenter Content="{TemplateBinding Footer}"
                                                              HorizontalAlignment="Right"
                                                              Visibility="{TemplateBinding CustomFooterVisibility}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Closable" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Drawer -->

    <Style TargetType="{x:Type antd:Drawer}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Antd.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Drawer}">
                    <Grid Background="Transparent">
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="True">
                            <Grid x:Name="PART_Surface" Background="Transparent">
                                <Rectangle x:Name="PART_Mask" Fill="{TemplateBinding MaskBrush}" />

                                <Border x:Name="PART_Card"
                                        Background="{TemplateBinding Background}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Effect="{StaticResource Antd.Effect.Elevated}"
                                        Focusable="True"
                                        KeyboardNavigation.TabNavigation="Cycle">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Padding="24,16,24,16"
                                                BorderBrush="{DynamicResource Antd.colorSplit}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <ContentPresenter Content="{TemplateBinding Title}"
                                                                  Margin="0,0,40,0"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.FontSize="16"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.Foreground="{DynamicResource Antd.colorTextHeading}" />
                                                <Border x:Name="PART_Close"
                                                        Width="28" Height="28"
                                                        Margin="0,0,-8,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="4"
                                                        Background="Transparent"
                                                        Cursor="Hand">
                                                    <antd:Icon Size="14" Data="{x:Static icons:AntdIcons.Close}" Foreground="{DynamicResource Antd.colorIcon}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <Border Padding="24">
                                                <ContentPresenter ContentSource="Content"
                                                                  TextElement.FontSize="14"
                                                                  TextElement.Foreground="{DynamicResource Antd.colorText}" />
                                            </Border>
                                        </ScrollViewer>

                                        <Border Grid.Row="2"
                                                Padding="16,8,16,8"
                                                BorderBrush="{DynamicResource Antd.colorSplit}"
                                                BorderThickness="0,1,0,0"
                                                Visibility="{TemplateBinding FooterVisibility}">
                                            <ContentPresenter Content="{TemplateBinding Footer}"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Closable" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Popconfirm -->

    <Style TargetType="{x:Type antd:Popconfirm}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:Popconfirm}">
                    <Grid Background="Transparent">
                        <ContentPresenter />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               StaysOpen="False">
                            <Border Background="{DynamicResource Antd.colorBgElevated}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    MaxWidth="300">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <antd:Icon Grid.Column="0"
                                                   Size="14"
                                                   Data="{TemplateBinding IconGeometry}"
                                                   Foreground="{TemplateBinding IconBrush}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,4,0,0"
                                                   Visibility="{TemplateBinding IconVisibility}" />
                                        <ContentPresenter Grid.Column="1"
                                                          Content="{TemplateBinding Title}"
                                                          TextElement.FontSize="14"
                                                          TextElement.FontWeight="SemiBold"
                                                          TextElement.Foreground="{DynamicResource Antd.colorTextHeading}" />
                                    </Grid>

                                    <ContentPresenter Content="{TemplateBinding Description}"
                                                      Margin="22,4,0,0"
                                                      TextElement.FontSize="14"
                                                      TextElement.Foreground="{DynamicResource Antd.colorText}"
                                                      Visibility="{TemplateBinding DescriptionVisibility}" />

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,8,0,0">
                                        <antd:Button x:Name="PART_Cancel"
                                                     Content="{TemplateBinding CancelText}"
                                                     Size="Small"
                                                     Visibility="{TemplateBinding ShowCancel, Converter={StaticResource Antd.BoolToVisibility}}" />
                                        <antd:Button x:Name="PART_Ok"
                                                     Content="{TemplateBinding ConfirmText}"
                                                     Size="Small"
                                                     Variant="Primary"
                                                     Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ QRCode -->

    <Style TargetType="{x:Type antd:QRCode}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type antd:QRCode}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>















