<Window x:Class="Antd.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:antd="clr-namespace:Antd.Wpf.Controls;assembly=Antd.Wpf.Controls"
        Title="Antd.Wpf Gallery"
        Height="860" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Antd.colorBgLayout}"
        FontFamily="{DynamicResource Antd.FontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,40,48,48" MaxWidth="960" HorizontalAlignment="Left">

            <!-- ============================================================ header -->
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Ant Design for WPF"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource Antd.colorTextTertiary}"
                               FontSize="14"
                               Text="M0 preview · design tokens derived from antd 6.6.8 and verified token by token" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <antd:Button x:Name="ThemeButton" Variant="Primary" Content="Switch to dark" Click="OnToggleTheme" />
                    <antd:Button Margin="8,0,0,0" Variant="Default" Content="Reset" Click="OnResetTheme" />
                </StackPanel>
            </DockPanel>

            <!-- ============================================================ button -->
            <Border x:Name="ButtonCard" Margin="0,32,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Button" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,20" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Five variants, danger mode, three sizes, shapes and loading state." />

                    <WrapPanel>
                        <antd:Button Content="Primary" Variant="Primary" Margin="0,0,8,8" />
                        <antd:Button Content="Default" Margin="0,0,8,8" />
                        <antd:Button Content="Dashed" Variant="Dashed" Margin="0,0,8,8" />
                        <antd:Button Content="Text" Variant="Text" Margin="0,0,8,8" />
                        <antd:Button Content="Link" Variant="Link" Margin="0,0,8,8" />
                        <antd:Button Content="Primary Danger" Variant="Primary" Danger="True" Margin="0,0,8,8" />
                        <antd:Button Content="Danger" Danger="True" Margin="0,0,8,8" />
                        <antd:Button Content="Disabled" IsEnabled="False" Margin="0,0,8,8" />
                    </WrapPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <antd:Button Content="Large" Size="Large" Margin="0,0,8,8" />
                        <antd:Button Content="Middle" Size="Middle" Margin="0,0,8,8" />
                        <antd:Button Content="Small" Size="Small" Margin="0,0,8,8" />
                        <antd:Button Content="Round" Shape="Round" Margin="0,0,8,8" />
                        <antd:Button Content="+" Shape="Circle" Margin="0,0,8,8" />
                        <antd:Button Content="Loading" Loading="True" Margin="0,0,8,8" />
                        <antd:Button Content="Primary Loading" Variant="Primary" Loading="True" Margin="0,0,8,8" />
                    </WrapPanel>

                    <antd:Button Content="Block button" Block="True" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ============================================================ input -->
            <Border x:Name="InputCard" Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Input" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,20" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Placeholder, clear button, affixes, sizes and validation status." />

                    <WrapPanel>
                        <antd:Input Width="220" Margin="0,0,12,12"
                                    Placeholder="Basic input" />
                        <antd:Input Width="220" Margin="0,0,12,12"
                                    AllowClear="True"
                                    Text="Clearable value" />
                        <antd:Input Width="220" Margin="0,0,12,12"
                                    Placeholder="Disabled" IsEnabled="False" />
                    </WrapPanel>

                    <WrapPanel>
                        <antd:Input Width="220" Margin="0,0,12,12" Placeholder="With prefix">
                            <antd:Input.Prefix>
                                <Path Width="14" Height="14"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Antd.colorTextTertiary}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      Data="M6,1 A5,5 0 1,0 6.01,1 M10,10 L14,14" />
                            </antd:Input.Prefix>
                        </antd:Input>
                        <antd:Input Width="220" Margin="0,0,12,12" Placeholder="With suffix" Text="antd">
                            <antd:Input.Suffix>
                                <TextBlock Text=".wpf" Foreground="{DynamicResource Antd.colorTextTertiary}" FontSize="14" />
                            </antd:Input.Suffix>
                        </antd:Input>
                    </WrapPanel>

                    <WrapPanel>
                        <antd:Input Width="150" Margin="0,0,12,12" Size="Large" Placeholder="Large" />
                        <antd:Input Width="150" Margin="0,0,12,12" Size="Small" Placeholder="Small" />
                        <antd:Input Width="220" Margin="0,0,12,12" Status="Error" Text="Error state" />
                        <antd:Input Width="220" Margin="0,0,12,12" Status="Warning" Text="Warning state" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ tokens -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Design tokens" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Read from ThemeManager.Current.Snapshot — the same table verified against theme.getDesignToken()." />
                    <StackPanel x:Name="TokensPanel" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
