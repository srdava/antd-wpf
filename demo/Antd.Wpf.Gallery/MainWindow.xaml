<Window
    x:Class="Antd.Wpf.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:antd="clr-namespace:Antd.Wpf.Controls;assembly=Antd.Wpf.Controls"
    xmlns:icons="clr-namespace:Antd.Wpf.Icons;assembly=Antd.Wpf.Icons"
    Title="Antd.Wpf Gallery"
    Width="1080"
    Height="660"
    Background="{DynamicResource Antd.colorBgLayout}"
    FontFamily="{DynamicResource Antd.FontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- A centred Border owns the page width. Using MaxWidth + HorizontalAlignment=Left on
             the panel itself lets a child that reports the full available width inflate the
             whole column, which is how the progress bars ended up outside the cards. -->
        <Border MaxWidth="1056" HorizontalAlignment="Center" Padding="48,40,48,48">
        <StackPanel>

            <!--  ============================================================ header  -->
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Ant Design for WPF" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource Antd.colorTextTertiary}"
                        Text="M0 preview · design tokens derived from antd 6.6.8 and verified token by token" />
                </StackPanel>
                <StackPanel
                    VerticalAlignment="Top"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <antd:Button
                        x:Name="ThemeButton"
                        Click="OnToggleTheme"
                        Content="Switch to dark"
                        Variant="Primary" />
                    <antd:Button
                        Margin="8,0,0,0"
                        Click="OnResetTheme"
                        Content="Reset"
                        Variant="Default" />
                </StackPanel>
            </DockPanel>

            <!--  ============================================================ button  -->
            <Border
                x:Name="ButtonCard"
                Margin="0,32,0,0"
                Padding="24"
                Background="{DynamicResource Antd.colorBgContainer}"
                BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Button" />
                    <TextBlock
                        Margin="0,4,0,20"
                        FontSize="13"
                        Foreground="{DynamicResource Antd.colorTextDescription}"
                        Text="Five variants, danger mode, three sizes, shapes and loading state." />

                    <WrapPanel>
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Primary"
                            Variant="Primary" />
                        <antd:Button Margin="0,0,8,8" Content="Default" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Dashed"
                            Variant="Dashed" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Text"
                            Variant="Text" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Link"
                            Variant="Link" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Primary Danger"
                            Danger="True"
                            Variant="Primary" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Danger"
                            Danger="True" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Disabled"
                            IsEnabled="False" />
                    </WrapPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Large"
                            Size="Large" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Middle"
                            Size="Middle" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Small"
                            Size="Small" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Round"
                            Shape="Round" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="+"
                            Shape="Circle" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Loading"
                            Loading="True" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Primary Loading"
                            Loading="True"
                            Variant="Primary" />
                    </WrapPanel>

                    <antd:Button
                        Margin="0,8,0,0"
                        Block="True"
                        Content="Block button" />
                </StackPanel>
            </Border>

            <!--  ============================================================ input  -->
            <Border
                x:Name="InputCard"
                Margin="0,16,0,0"
                Padding="24"
                Background="{DynamicResource Antd.colorBgContainer}"
                BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Input" />
                    <TextBlock
                        Margin="0,4,0,20"
                        FontSize="13"
                        Foreground="{DynamicResource Antd.colorTextDescription}"
                        Text="Placeholder, clear button, affixes, sizes and validation status." />

                    <WrapPanel>
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Placeholder="Basic input" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            AllowClear="True"
                            Text="Clearable value" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            IsEnabled="False"
                            Placeholder="Disabled" />
                    </WrapPanel>

                    <WrapPanel>
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Placeholder="With prefix">
                            <antd:Input.Prefix>
                                <Path
                                    Width="14"
                                    Height="14"
                                    Data="M6,1 A5,5 0 1,0 6.01,1 M10,10 L14,14"
                                    Stretch="Uniform"
                                    Stroke="{DynamicResource Antd.colorTextTertiary}"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.4" />
                            </antd:Input.Prefix>
                        </antd:Input>
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Placeholder="With suffix"
                            Text="antd">
                            <antd:Input.Suffix>
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{DynamicResource Antd.colorTextTertiary}"
                                    Text=".wpf" />
                            </antd:Input.Suffix>
                        </antd:Input>
                    </WrapPanel>

                    <WrapPanel>
                        <antd:Input
                            Width="150"
                            Margin="0,0,12,12"
                            Placeholder="Large"
                            Size="Large" />
                        <antd:Input
                            Width="150"
                            Margin="0,0,12,12"
                            Placeholder="Small"
                            Size="Small" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Status="Error"
                            Text="Error state" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Status="Warning"
                            Text="Warning state" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- layout -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Space &amp; Divider" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Uniform gaps without edge margins, plus three divider forms." />

                    <antd:Divider Text="Space sizes" Margin="0,0,0,12" />
                    <antd:Space Size="Small" Margin="0,0,0,8">
                        <antd:Button Content="Small gap" Size="Small" />
                        <antd:Button Content="Small gap" Size="Small" />
                        <antd:Button Content="Small gap" Size="Small" />
                    </antd:Space>
                    <antd:Space Margin="0,0,0,8">
                        <antd:Button Content="Middle gap" />
                        <antd:Button Content="Middle gap" />
                        <antd:Button Content="Middle gap" />
                    </antd:Space>

                    <antd:Divider Dashed="True" Margin="0,16,0,16" />
                    <TextBlock Text="Dashed divider above, plain text divider below" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextTertiary}" />
                    <antd:Divider PlainText="True" Text="Plain text" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- display -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Tag, Badge, Avatar, Statistic" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Status labels, counters, identities and metrics." />

                    <antd:Space Margin="0,0,0,16">
                        <antd:Tag Content="Default" />
                        <antd:Tag Content="Processing" Color="Processing" />
                        <antd:Tag Content="Success" Color="Success" />
                        <antd:Tag Content="Warning" Color="Warning" />
                        <antd:Tag Content="Error" Color="Error" />
                        <antd:Tag Content="Closable" Closable="True" />
                    </antd:Space>

                    <antd:Space Margin="0,0,0,16">
                        <antd:Badge Count="5">
                            <TextBlock Text="Inbox" FontSize="14" Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Badge>
                        <antd:Badge Count="128">
                            <TextBlock Text="Overflow" FontSize="14" Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Badge>
                        <antd:Badge Dot="True">
                            <TextBlock Text="Dot" FontSize="14" Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Badge>
                    </antd:Space>

                    <antd:Space Margin="0,0,0,16">
                        <antd:Avatar Content="A" />
                        <antd:Avatar Content="B" Shape="Square" />
                        <antd:Avatar Content="C" Size="40" />
                        <antd:Avatar>
                            <antd:Icon Data="{x:Static icons:AntdIcons.User}" Size="16"
                                       Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Avatar>
                    </antd:Space>

                    <antd:Space>
                        <antd:Statistic Title="Active users" Value="112893" />
                        <antd:Statistic Title="Balance" Value="1284.32" Precision="2" />
                    </antd:Space>
                </StackPanel>
            </Border>

            <!-- feedback -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Progress, Spin, Skeleton, Empty, Segmented" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Loading, placeholder and progress states." />

                    <antd:Progress Percent="30" Margin="0,0,0,8" />
                    <antd:Progress Percent="70" Margin="0,0,0,8" />
                    <antd:Progress Percent="100" Status="Success" Margin="0,0,0,16" />

                    <antd:Segmented x:Name="RangeSegmented" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <antd:Progress Grid.Column="0" Type="Circle" Percent="68" CircleSize="88" />
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <antd:Spin Spinning="True" />
                            <antd:Spin Spinning="True" Size="Large" Margin="0,12,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="220" Margin="24,0,0,0">
                            <antd:Skeleton Rows="3" Avatar="True" Active="True" />
                        </StackPanel>
                        <antd:Empty Grid.Column="3" Margin="24,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- typography -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Typography" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,12" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Five heading levels, semantic text colours and a link." />

                    <antd:Title Level="1" Text="Heading 1" />
                    <antd:Title Level="2" Text="Heading 2" />
                    <antd:Title Level="3" Text="Heading 3" />
                    <antd:Title Level="4" Text="Heading 4" />
                    <antd:Title Level="5" Text="Heading 5" />

                    <antd:Paragraph Text="A paragraph of body copy rendered with the antd line height of 22/14. Use Paragraph for blocks of text that need consistent rhythm." />
                    <antd:Paragraph Type="Secondary" Text="Secondary paragraph used for supporting copy." />

                    <WrapPanel Margin="0,0,0,8">
                        <antd:Text Text="Default text  " Margin="0,0,16,0" />
                        <antd:Text Text="Secondary" Type="Secondary" Margin="0,0,16,0" />
                        <antd:Text Text="Success" Type="Success" Margin="0,0,16,0" />
                        <antd:Text Text="Warning" Type="Warning" Margin="0,0,16,0" />
                        <antd:Text Text="Danger" Type="Danger" Margin="0,0,16,0" />
                        <antd:Text Text="Strong" Strong="True" Margin="0,0,16,0" />
                        <antd:Text Text="Disabled" Disabled="True" Margin="0,0,16,0" />
                        <antd:Text Text="Underline" Underline="True" Margin="0,0,16,0" />
                    </WrapPanel>
                    <antd:Link Text="A hyperlink styled with colorLink" />
                </StackPanel>
            </Border>

            <!-- layout -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Layout, Grid and Flex" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Header/Sider/Content/Footer, a 24-column grid and flex alignment." />

                    <Border Height="160" CornerRadius="6" ClipToBounds="True"
                            BorderBrush="{DynamicResource Antd.colorBorderSecondary}" BorderThickness="1">
                        <antd:Layout>
                            <antd:Header>
                                <antd:Text Text="Header" Type="Secondary" />
                            </antd:Header>
                            <antd:Layout>
                                <antd:Sider SiderWidth="140">
                                    <antd:Text Text="Sider" Type="Secondary" Margin="16" />
                                </antd:Sider>
                                <antd:Content>
                                    <antd:Text Text="Content" Type="Secondary" />
                                </antd:Content>
                            </antd:Layout>
                            <antd:Footer>
                                <antd:Text Text="Footer" Type="Secondary" />
                            </antd:Footer>
                        </antd:Layout>
                    </Border>

                    <antd:Row Gutter="16" Margin="0,16,0,0">
                        <antd:Col Span="8">
                            <Border Background="{DynamicResource Antd.colorFillTertiary}" CornerRadius="4" Padding="8">
                                <antd:Text Text="span 8" Type="Secondary" />
                            </Border>
                        </antd:Col>
                        <antd:Col Span="8">
                            <Border Background="{DynamicResource Antd.colorFillTertiary}" CornerRadius="4" Padding="8">
                                <antd:Text Text="span 8" Type="Secondary" />
                            </Border>
                        </antd:Col>
                        <antd:Col Span="8">
                            <Border Background="{DynamicResource Antd.colorFillTertiary}" CornerRadius="4" Padding="8">
                                <antd:Text Text="span 8" Type="Secondary" />
                            </Border>
                        </antd:Col>
                    </antd:Row>

                    <antd:Flex Justify="SpaceBetween" Margin="0,12,0,0">
                        <antd:Button Content="Flex start" Size="Small" />
                        <antd:Button Content="SpaceBetween" Size="Small" Variant="Primary" />
                        <antd:Button Content="Flex end" Size="Small" />
                    </antd:Flex>
                </StackPanel>
            </Border>

            <!-- form -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Form controls" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="InputNumber, Checkbox, Radio, Switch, Rate, Slider, Select and a validating Form." />

                    <antd:Form x:Name="DemoForm" MaxWidth="520" HorizontalAlignment="Left">
                        <antd:FormItem x:Name="NameItem" Label="Name" Required="True" Help="Required field, validated on submit.">
                            <antd:Input x:Name="NameInput" Placeholder="Your name" />
                        </antd:FormItem>

                        <antd:FormItem Label="Framework">
                            <antd:Select x:Name="FrameworkSelect" AllowClear="True" Placeholder="Pick one" />
                        </antd:FormItem>

                        <antd:FormItem Label="Quantity">
                            <antd:InputNumber x:Name="QuantityInput" Value="3" Minimum="1" Maximum="20" Width="140" HorizontalAlignment="Left" />
                        </antd:FormItem>

                        <antd:FormItem Label="Notifications">
                            <antd:Switch x:Name="NotifySwitch" HorizontalAlignment="Left" />
                        </antd:FormItem>

                        <antd:FormItem Label="Rating">
                            <antd:Rate x:Name="RateInput" Value="3" HorizontalAlignment="Left" />
                        </antd:FormItem>

                        <antd:FormItem Label="Threshold">
                            <antd:Slider x:Name="ThresholdSlider" Minimum="0" Maximum="100" Value="40" />
                        </antd:FormItem>

                        <antd:FormItem Label="Plan">
                            <antd:Space>
                                <antd:Radio Content="Free" GroupName="plan" IsChecked="True" />
                                <antd:Radio Content="Pro" GroupName="plan" />
                                <antd:Radio Content="Team" GroupName="plan" />
                            </antd:Space>
                        </antd:FormItem>

                        <antd:FormItem Label="Extras">
                            <antd:Space Orientation="Vertical" Size="Small">
                                <antd:Checkbox Content="Email digest" IsChecked="True" />
                                <antd:Checkbox Content="Weekly report" />
                                <antd:Checkbox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
                            </antd:Space>
                        </antd:FormItem>

                        <antd:FormItem>
                            <antd:Space>
                                <antd:Button Content="Submit" Variant="Primary" Click="OnSubmitForm" />
                                <antd:Button Content="Reset" Click="OnResetForm" />
                            </antd:Space>
                        </antd:FormItem>
                    </antd:Form>
                </StackPanel>
            </Border>

            <!-- autocomplete + calendar -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="AutoComplete &amp; Calendar" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Free text with filtered suggestions, and a month grid with navigation." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Framework" FontSize="13" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            <antd:AutoComplete x:Name="FrameworkAuto"
                                               Width="320"
                                               HorizontalAlignment="Left"
                                               Placeholder="Type to filter" />

                            <TextBlock Text="Start date" FontSize="13" Margin="0,20,0,8"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            <antd:DatePicker x:Name="DemoDatePicker"
                                             Width="320"
                                             HorizontalAlignment="Left" />
                            <TextBlock Margin="0,12,0,0" FontSize="13"
                                       Foreground="{DynamicResource Antd.colorTextTertiary}"
                                       TextWrapping="Wrap"
                                       Text="Type 'w' or 'ava'. Up/Down to move, Enter to accept, Esc to dismiss." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                            <antd:Calendar x:Name="DemoCalendar" Width="308" MaxWidth="308" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- splitter / affix / border beam -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Splitter, Affix, BorderBeam" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="A draggable divider, sticky content inside a scroller, and a beam that runs around a card." />

                    <Grid Height="110">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Antd.colorFillQuaternary}"
                                CornerRadius="6">
                            <TextBlock Text="Left pane" Margin="12" FontSize="13"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                        </Border>

                        <antd:Splitter Grid.Column="1" ResizeDirection="Columns"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                        <Border Grid.Column="2" Background="{DynamicResource Antd.colorFillQuaternary}"
                                CornerRadius="6">
                            <TextBlock Text="Right pane" Margin="12" FontSize="13"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" Height="120" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <antd:Affix OffsetTop="0">
                                    <Border Background="{DynamicResource Antd.colorBgElevated}"
                                            BorderBrush="{DynamicResource Antd.colorSplit}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,6">
                                        <TextBlock Text="Pinned header (scroll me)"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Antd.colorText}" />
                                    </Border>
                                </antd:Affix>
                                <TextBlock Margin="8,8,8,0" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource Antd.colorTextTertiary}"
                                           Text="Scroll this box and the header above stays pinned to its top edge. The control tracks the nearest ScrollViewer and offsets itself instead of reparenting." />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="1" Width="260" Height="120" Margin="24,0,0,0">
                            <Border Background="{DynamicResource Antd.colorBgContainer}"
                                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBlock Text="Beam" Margin="16" VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            </Border>
                            <antd:BorderBeam CornerRadius="10" BeamThickness="2" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- tree -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Tree" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Hierarchical list with tri-state check boxes; checking a parent cascades down and half-checked parents report indeterminate." />

                    <antd:Tree x:Name="DemoTree" Checkable="True" Height="240" />
                </StackPanel>
            </Border>

            <!-- time picker + mentions -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="TimePicker &amp; Mentions" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Scrollable hour/minute/second columns, and an input that suggests people after '@'." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Starts at" FontSize="13" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            <antd:TimePicker x:Name="DemoTimePicker" HorizontalAlignment="Left" Width="200" />

                            <TextBlock Text="Accent" FontSize="13" Margin="0,20,0,8"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            <antd:ColorPicker x:Name="DemoColorPicker" HorizontalAlignment="Left" Width="200" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Comment" FontSize="13" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            <antd:Mentions x:Name="DemoMentions" Height="72"
                                           VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- upload + transfer -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Upload &amp; Transfer" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="A dashed drop zone with a file list, and two lists that shuttle items across." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <antd:Upload x:Name="DemoUpload" Hint="Click or drop images here" />
                        </StackPanel>

                        <antd:Transfer Grid.Column="1"
                                       x:Name="DemoTransfer"
                                       SourceTitle="Available"
                                       TargetTitle="Selected" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- table -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Table" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Virtualised rows, sortable headers and row selection, painted with antd colours." />

                    <antd:Table x:Name="DemoTable" Height="260">
                        <antd:Table.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="160" />
                        </antd:Table.Columns>
                    </antd:Table>
                </StackPanel>
            </Border>

            <!-- tree select + cascader -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="TreeSelect &amp; Cascader" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="A tree inside a select, and a cascading column picker." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Component" FontSize="13" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            <antd:TreeSelect x:Name="DemoTreeSelect" HorizontalAlignment="Left" Width="280" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Region" FontSize="13" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Antd.colorTextSecondary}" />
                            <antd:Cascader x:Name="DemoCascader" HorizontalAlignment="Left" Width="280" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ============================================================ tokens  -->
            <Border
                Margin="0,16,0,0"
                Padding="24"
                Background="{DynamicResource Antd.colorBgContainer}"
                BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Design tokens" />
                    <TextBlock
                        Margin="0,4,0,16"
                        FontSize="13"
                        Foreground="{DynamicResource Antd.colorTextDescription}"
                        Text="Read from ThemeManager.Current.Snapshot — the same table verified against theme.getDesignToken()." />
                    <StackPanel x:Name="TokensPanel" />
                </StackPanel>
            </Border>

        </StackPanel>
        </Border>

    </ScrollViewer>
</Window>
