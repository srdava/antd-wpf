<Window
    x:Class="Antd.Wpf.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:antd="clr-namespace:Antd.Wpf.Controls;assembly=Antd.Wpf.Controls"
    xmlns:icons="clr-namespace:Antd.Wpf.Icons;assembly=Antd.Wpf.Icons"
    Title="Antd.Wpf Gallery"
    Width="1080"
    Height="660"
    Background="{DynamicResource Antd.colorBgLayout}"
    FontFamily="{DynamicResource Antd.FontFamily}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="960"
            Margin="48,40,48,48"
            HorizontalAlignment="Left">

            <!--  ============================================================ header  -->
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Ant Design for WPF" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource Antd.colorTextTertiary}"
                        Text="M0 preview · design tokens derived from antd 6.6.8 and verified token by token" />
                </StackPanel>
                <StackPanel
                    VerticalAlignment="Top"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <antd:Button
                        x:Name="ThemeButton"
                        Click="OnToggleTheme"
                        Content="Switch to dark"
                        Variant="Primary" />
                    <antd:Button
                        Margin="8,0,0,0"
                        Click="OnResetTheme"
                        Content="Reset"
                        Variant="Default" />
                </StackPanel>
            </DockPanel>

            <!--  ============================================================ button  -->
            <Border
                x:Name="ButtonCard"
                Margin="0,32,0,0"
                Padding="24"
                Background="{DynamicResource Antd.colorBgContainer}"
                BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Button" />
                    <TextBlock
                        Margin="0,4,0,20"
                        FontSize="13"
                        Foreground="{DynamicResource Antd.colorTextDescription}"
                        Text="Five variants, danger mode, three sizes, shapes and loading state." />

                    <WrapPanel>
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Primary"
                            Variant="Primary" />
                        <antd:Button Margin="0,0,8,8" Content="Default" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Dashed"
                            Variant="Dashed" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Text"
                            Variant="Text" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Link"
                            Variant="Link" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Primary Danger"
                            Danger="True"
                            Variant="Primary" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Danger"
                            Danger="True" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Disabled"
                            IsEnabled="False" />
                    </WrapPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Large"
                            Size="Large" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Middle"
                            Size="Middle" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Small"
                            Size="Small" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Round"
                            Shape="Round" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="+"
                            Shape="Circle" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Loading"
                            Loading="True" />
                        <antd:Button
                            Margin="0,0,8,8"
                            Content="Primary Loading"
                            Loading="True"
                            Variant="Primary" />
                    </WrapPanel>

                    <antd:Button
                        Margin="0,8,0,0"
                        Block="True"
                        Content="Block button" />
                </StackPanel>
            </Border>

            <!--  ============================================================ input  -->
            <Border
                x:Name="InputCard"
                Margin="0,16,0,0"
                Padding="24"
                Background="{DynamicResource Antd.colorBgContainer}"
                BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Input" />
                    <TextBlock
                        Margin="0,4,0,20"
                        FontSize="13"
                        Foreground="{DynamicResource Antd.colorTextDescription}"
                        Text="Placeholder, clear button, affixes, sizes and validation status." />

                    <WrapPanel>
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Placeholder="Basic input" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            AllowClear="True"
                            Text="Clearable value" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            IsEnabled="False"
                            Placeholder="Disabled" />
                    </WrapPanel>

                    <WrapPanel>
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Placeholder="With prefix">
                            <antd:Input.Prefix>
                                <Path
                                    Width="14"
                                    Height="14"
                                    Data="M6,1 A5,5 0 1,0 6.01,1 M10,10 L14,14"
                                    Stretch="Uniform"
                                    Stroke="{DynamicResource Antd.colorTextTertiary}"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.4" />
                            </antd:Input.Prefix>
                        </antd:Input>
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Placeholder="With suffix"
                            Text="antd">
                            <antd:Input.Suffix>
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{DynamicResource Antd.colorTextTertiary}"
                                    Text=".wpf" />
                            </antd:Input.Suffix>
                        </antd:Input>
                    </WrapPanel>

                    <WrapPanel>
                        <antd:Input
                            Width="150"
                            Margin="0,0,12,12"
                            Placeholder="Large"
                            Size="Large" />
                        <antd:Input
                            Width="150"
                            Margin="0,0,12,12"
                            Placeholder="Small"
                            Size="Small" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Status="Error"
                            Text="Error state" />
                        <antd:Input
                            Width="220"
                            Margin="0,0,12,12"
                            Status="Warning"
                            Text="Warning state" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- layout -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Space &amp; Divider" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Uniform gaps without edge margins, plus three divider forms." />

                    <antd:Divider Text="Space sizes" Margin="0,0,0,12" />
                    <antd:Space Size="Small" Margin="0,0,0,8">
                        <antd:Button Content="Small gap" Size="Small" />
                        <antd:Button Content="Small gap" Size="Small" />
                        <antd:Button Content="Small gap" Size="Small" />
                    </antd:Space>
                    <antd:Space Margin="0,0,0,8">
                        <antd:Button Content="Middle gap" />
                        <antd:Button Content="Middle gap" />
                        <antd:Button Content="Middle gap" />
                    </antd:Space>

                    <antd:Divider Dashed="True" Margin="0,16,0,16" />
                    <TextBlock Text="Dashed divider above, plain text divider below" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextTertiary}" />
                    <antd:Divider PlainText="True" Text="Plain text" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- display -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Tag, Badge, Avatar, Statistic" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Status labels, counters, identities and metrics." />

                    <antd:Space Margin="0,0,0,16">
                        <antd:Tag Content="Default" />
                        <antd:Tag Content="Processing" Color="Processing" />
                        <antd:Tag Content="Success" Color="Success" />
                        <antd:Tag Content="Warning" Color="Warning" />
                        <antd:Tag Content="Error" Color="Error" />
                        <antd:Tag Content="Closable" Closable="True" />
                    </antd:Space>

                    <antd:Space Margin="0,0,0,16">
                        <antd:Badge Count="5">
                            <TextBlock Text="Inbox" FontSize="14" Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Badge>
                        <antd:Badge Count="128">
                            <TextBlock Text="Overflow" FontSize="14" Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Badge>
                        <antd:Badge Dot="True">
                            <TextBlock Text="Dot" FontSize="14" Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Badge>
                    </antd:Space>

                    <antd:Space Margin="0,0,0,16">
                        <antd:Avatar Content="A" />
                        <antd:Avatar Content="B" Shape="Square" />
                        <antd:Avatar Content="C" Size="40" />
                        <antd:Avatar>
                            <antd:Icon Data="{x:Static icons:AntdIcons.User}" Size="16"
                                       Foreground="{DynamicResource Antd.colorText}" />
                        </antd:Avatar>
                    </antd:Space>

                    <antd:Space>
                        <antd:Statistic Title="Active users" Value="112893" />
                        <antd:Statistic Title="Balance" Value="1284.32" Precision="2" />
                    </antd:Space>
                </StackPanel>
            </Border>

            <!-- feedback -->
            <Border Margin="0,16,0,0" Padding="24"
                    Background="{DynamicResource Antd.colorBgContainer}"
                    BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Progress, Spin, Skeleton, Empty, Segmented" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Antd.colorTextHeading}" />
                    <TextBlock Margin="0,4,0,16" FontSize="13"
                               Foreground="{DynamicResource Antd.colorTextDescription}"
                               Text="Loading, placeholder and progress states." />

                    <antd:Progress Percent="30" Margin="0,0,0,8" />
                    <antd:Progress Percent="70" Margin="0,0,0,8" />
                    <antd:Progress Percent="100" Status="Success" Margin="0,0,0,16" />

                    <antd:Segmented x:Name="RangeSegmented" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <antd:Progress Grid.Column="0" Type="Circle" Percent="68" CircleSize="88" />
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <antd:Spin Spinning="True" />
                            <antd:Spin Spinning="True" Size="Large" Margin="0,12,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="220" Margin="24,0,0,0">
                            <antd:Skeleton Rows="3" Avatar="True" Active="True" />
                        </StackPanel>
                        <antd:Empty Grid.Column="3" Margin="24,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ============================================================ tokens  -->
            <Border
                Margin="0,16,0,0"
                Padding="24"
                Background="{DynamicResource Antd.colorBgContainer}"
                BorderBrush="{DynamicResource Antd.colorBorderSecondary}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Antd.colorTextHeading}"
                        Text="Design tokens" />
                    <TextBlock
                        Margin="0,4,0,16"
                        FontSize="13"
                        Foreground="{DynamicResource Antd.colorTextDescription}"
                        Text="Read from ThemeManager.Current.Snapshot — the same table verified against theme.getDesignToken()." />
                    <StackPanel x:Name="TokensPanel" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
