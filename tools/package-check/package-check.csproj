<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway consumer used to prove the packed 1.0.0 nupkgs are installable and usable. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestoreSources>$(MSBuildThisFileDirectory)..\..\artifacts\packages;https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antd.Wpf.Controls" Version="1.0.0" />
  </ItemGroup>

</Project>
