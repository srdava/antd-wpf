<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumer used to prove the packed nupkgs are installable and usable on both targets. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestoreSources>$(MSBuildThisFileDirectory)..\..\artifacts\packages;https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antd.Wpf.Controls" Version="1.0.0" />
  </ItemGroup>

</Project>
