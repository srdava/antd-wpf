<Project Sdk="Microsoft.NET.Sdk">

  <!-- Purpose-built window for the UI automation tests: every element the tests drive has an
       AutomationId, so the tests never depend on visual text or layout. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Antd.Wpf.Controls\Antd.Wpf.Controls.csproj" />
  </ItemGroup>

</Project>
